# Railway / app
PORT=8080
PUBLIC_URL=https://YOUR-RAILWAY-DOMAIN
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
COOKIE_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Telegram
BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE
TELEGRAM_WEBHOOK_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET

# Railway Postgres
# On Railway, reference your Postgres service:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Optional fallback if you want to hard-pin a channel ID.
# The app can auto-discover the channel ID from Telegram updates.
CHANNEL_ID=

# Advertising invite links.
# These are filled from the admin dashboard after you create them.
FACEBOOK_INVITE_LINK=
INSTAGRAM_INVITE_LINK=

# App name shown in dashboard
CHANNEL_NAME=VISHAL QX
